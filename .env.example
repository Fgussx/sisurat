# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# Never commit .env to version control

# ==========================================
# Database Configuration
# ==========================================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
MONGODB_URI=mongodb+srv://sisurat_user:password@cluster.mongodb.net/sisurat_db?retryWrites=true&w=majority

# ==========================================
# JWT Configuration
# ==========================================
# Secret key for access tokens (min 32 characters, use strong random value)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_access_token_secret_key_min_32_characters_strong_random_value

# Secret key for refresh tokens (min 32 characters, use strong random value)
JWT_REFRESH_SECRET=your_refresh_token_secret_key_min_32_characters_strong_random_value

# ==========================================
# Email Configuration (Gmail)
# ==========================================
# Gmail account email address
EMAIL_USER=your_email@gmail.com

# Gmail App Password (NOT regular password)
# Generate at: https://myaccount.google.com/apppasswords
# 1. Enable 2-Step Verification
# 2. Generate App Password for Mail + Windows Computer
# 3. Use the 16-character password here
EMAIL_PASSWORD=your_16_char_app_password

# ==========================================
# Server Configuration
# ==========================================
# Environment: development, production
NODE_ENV=development

# Server port (default: 5000)
PORT=5000

# ==========================================
# Security Configuration
# ==========================================
# Allowed origins for CORS (comma-separated)
# Development: http://localhost:5000
# Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5000,https://sisurat.vercel.app

# ==========================================
# Logging Configuration
# ==========================================
# Log level: error, warn, info, debug
LOG_LEVEL=info

# ==========================================
# Cloudinary Configuration (File Uploads)
# ==========================================
# Get your credentials from https://cloudinary.com
# Sign up for free at https://cloudinary.com/users/register/free
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==========================================
# Optional: Figma Make Configuration
# ==========================================
# FIGMA_PUBLIC_URL=https://your-vercel-url.vercel.app
